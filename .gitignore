target/

# Local experiment scratch space (keep inside repo to avoid external temp churn)
.tmp/
.tmp-work/

# Stray CLI output captures and draft PR bodies
out*.txt
pr_body.txt

# Local benchmark host aliases/secrets
.benchmark-hosts.env

# External reference material: PDFs stay local (large binaries), but tracked
# reference notes (markdown) under docs/external/ ARE committed.
docs/external/*
!docs/external/*.md

# Python bytecode (study scripts)
__pycache__/
*.pyc

# local scratch / benchmark outputs
tmp/

# Claude Code's per-developer permission grants. `settings.local.json` is
# personal by convention — it records which commands one machine may run
# without prompting — so it is ignored rather than committed. A shared
# `.claude/settings.json`, if one is ever wanted, stays trackable.
.claude/settings.local.json
